# Add project specific R8 rules here.
# AGP will combine all keep rule files in src/main/keepRules to pass to R8
#
# For more details, see
#   https://d.android.com/r/tools/r8/keep-rules

# JNI: llama.cpp / RunAnywhere native entry points must survive shrinking
-keepclasseswithmembernames class * {
    native <methods>;
}

# RunAnywhere SDK reflection / serialization surface
-keep class com.runanywhere.** { *; }
-keep class com.google.mlkit.** { *; }
-dontwarn com.runanywhere.**